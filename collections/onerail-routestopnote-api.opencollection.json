              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return."
              }
            ]
          },
          "docs": "Get paginated route stop notes"
        },
        {
          "info": {
            "name": "Creates a route stop note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/route/:routeId/route-stop-notes",
            "params": [
              {
                "name": "routeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a route stop note"
        }
      ]
    }
  ],
  "bundled": true
