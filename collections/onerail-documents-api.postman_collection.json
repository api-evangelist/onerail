      "item": [
        {
          "id": "2f28b0d1-6123-4311-ab27-55d6abe1b4ab",
          "name": "Retrieve all documents associated with a specific delivery. This includes a variety of documents required for the shipment process, such as shipping labels, hazard labels, Bills of Lading (BOL), invoices, and additional delivery receipts.",
          "request": {
            "name": "Retrieve all documents associated with a specific delivery. This includes a variety of documents required for the shipment process, such as shipping labels, hazard labels, Bills of Lading (BOL), invoices, and additional delivery receipts.",
            "description": {
              "content": "Fetches all documents linked to a given delivery or order ID. These documents may include mandatory shipment documentation, regulatory compliance forms, hazardous materials labels (if applicable), and other related paperwork essential for tracking and verification purposes. This endpoint supports authentication and requires a valid `deliveryId` or `orderId` parameter to identify the delivery in question.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "delivery",
                ":id",
                "documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "withBase64",
                  "value": "false",
                  "description": "Indicates whether the documents should be returned as base64-encoded strings."
                },
                {
                  "disabled": false,
                  "key": "containerId",
                  "value": "<string>",
                  "description": "Optional shipper container ID to filter documents for a specific container within the delivery."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The unique identifier for the delivery, used to locate and retrieve its associated documents or order id ."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-ONERAIL-API-KEY-AND-APP-ID"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
