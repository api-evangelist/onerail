{
  "opencollection": "1.0.0",
  "info": {
    "name": "Onerail Manifest API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Manifest",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Close a carrier manifest",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/close-manifest",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY-AND-APP-ID",
              "value": "{{X-ONERAIL-API-KEY-AND-APP-ID}}",
              "placement": "header"
            }
          },
          "docs": "Close a carrier manifest. Required fields depend on `carrierCode`."
        },
        {
          "info": {
            "name": "Closes a carrier manifest",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/close-manifest",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY",
              "value": "{{X-ONERAIL-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Closes a carrier manifest for the authenticated shipper."
        }
      ]
    }
  ],
  "bundled": true
}