              }
            ]
          },
          "docs": "Get all triggers for a service level"
        },
        {
          "info": {
            "name": "Create a service level trigger",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/service-level/:serviceLevelId/trigger",
            "params": [
              {
                "name": "serviceLevelId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a service level trigger"
        },
        {
          "info": {
            "name": "Get trigger for a service level",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/service-level/:serviceLevelId/trigger/:triggerId",
            "params": [
              {
                "name": "serviceLevelId",
                "value": "",
                "type": "path"
              },
              {
                "name": "triggerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get trigger for a service level"
