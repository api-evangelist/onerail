        {
          "info": {
            "name": "Update trigger for service level",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/v1/service-level/:serviceLevelId/trigger/:triggerId",
            "params": [
              {
                "name": "serviceLevelId",
                "value": "",
                "type": "path"
              },
              {
                "name": "triggerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update trigger for service level"
        },
        {
          "info": {
            "name": "Remove a service level trigger",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/service-level/:serviceLevelId/trigger/:triggerId",
            "params": [
              {
                "name": "serviceLevelId",
                "value": "",
                "type": "path"
              },
              {
                "name": "triggerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a service level trigger"
