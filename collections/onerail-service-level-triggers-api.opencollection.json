{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneRail Operation Dashboard Service Level Triggers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
