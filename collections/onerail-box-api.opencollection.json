              }
            ]
          },
          "docs": "Get Box"
        },
        {
          "info": {
            "name": "Update a Box",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/v1/box/:boxId",
            "params": [
              {
                "name": "boxId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Box"
        },
        {
          "info": {
            "name": "Remove box",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/box/:boxId",
            "params": [
              {
                "name": "boxId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove box"
        },
        {
          "info": {
            "name": "Update a Box via api",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/v1/box/:boxId/api",
            "params": [
              {
                "name": "boxId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY",
              "value": "{{X-ONERAIL-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Update a Box via api"
        },
        {
          "info": {
            "name": "Remove box via api",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v1/box/:boxId/api",
            "params": [
              {
                "name": "boxId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY",
              "value": "{{X-ONERAIL-API-KEY}}",
