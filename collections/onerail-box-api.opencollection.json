{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneRail Operation Dashboard Box API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Box",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Box",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/box",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Box"
        },
        {
          "info": {
            "name": "Create Box via api",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v1/box/api",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY",
              "value": "{{X-ONERAIL-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Create Box via api"
        },
        {
          "info": {
            "name": "Get Box",
