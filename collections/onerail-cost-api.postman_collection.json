      "item": [
        {
          "id": "31bdef42-7d89-4134-a558-09816ece8db0",
          "name": "Create an externally-sourced adjustment cost on a delivery attempt",
          "request": {
            "name": "Create an externally-sourced adjustment cost on a delivery attempt",
            "description": {
              "content": "Inserts a single adjustment Cost into the Core operations DB on behalf of an\nexternal producer (today: the FAP `InvoiceCostSyncService`; tomorrow: any\nother service-to-service producer that owns its own idempotency keys).\nStamps `reason = ADJUSTMENT` server-side; the sub-category is selected by\nthe caller via `costAdjustmentReasonId`, which must resolve to a row in\n`CostAdjustmentReasons`.\n\nIdempotency: the request body `sourceCostId` is the producer's globally\nunique identifier for this cost (e.g. FAP `InvoiceCost.PublicId`). If a\nCost row already exists with this `sourceCostId`, the endpoint returns\n200 with the existing record instead of creating a duplicate. Otherwise,\na new Cost is inserted and returned with 201. The unique index on\n`Costs.sourceCostId` counts soft-deleted rows too, so a previously\nsoft-deleted match also returns 200 (operator deletion intent is\npreserved; the row is not resurrected).\n\n`adjustmentUserId`, when supplied, must resolve to an existing `Users`\nrow in Core; unknown IDs are rejected with 400. Omit or send null for\nadjustments created by automated/system flows that have no human actor —\n`sourceCostId` remains the authoritative marker that the row originated\nfrom an external producer, so callers are never required to invent a\nsynthetic user. A `cost_changes` Kafka event is always emitted with\n`newValues.sourceCostId` populated and `userId` set to the same\n`adjustmentUserId`; consumers use `sourceCostId` as an echo filter to\nskip self-originated events.\n\nAuthentication: OneRail-organization API key only (`X-OneRail-API-Key` +\n`X-OneRail-App-Id`). JWT and non-OneRail API keys are rejected with 403.\nThis is pure service-to-service — no user identity is resolved from the\nrequest and operator-driven adjustments belong on a separate user-JWT\nendpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "delivery-attempt",
                ":deliveryAttemptId",
                "costs",
                "adjustments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "deliveryAttemptId",
                  "description": "(Required) Delivery attempt UUID that the cost belongs to."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-ONERAIL-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceCostId\": \"<uuid>\",\n  \"costAdjustmentReasonId\": \"<uuid>\",\n  \"costCent\": \"<integer>\",\n  \"isShipper\": \"<boolean>\",\n  \"adjustmentUserId\": \"<string,null-uuid>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
