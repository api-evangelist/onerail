{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneRail Operation Dashboard Holiday API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Holiday",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get holiday date for a specific year",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v1/holiday/:holidayId",
            "params": [
              {
                "name": "holidayId",
                "value": "",
                "type": "path",
                "description": "Holiday Id"
              },
              {
                "name": "year",
                "value": "",
                "type": "query",
                "description": "Year to get the holiday date for"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-ONERAIL-API-KEY",
              "value": "{{X-ONERAIL-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get holiday date for a specific year"
        }
      ]
    }
  ],
  "bundled": true
}